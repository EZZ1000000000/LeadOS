# انسخ الملف ده لـ .env وعبّي القيم

# رابط تطبيق LeadOS على Vercel (بدون / في الآخر)
LEADOS_BASE_URL=https://your-leados.vercel.app

# نفس قيمة INGEST_API_KEY اللي في Environment Variables بتاعة Vercel
LEADOS_API_KEY=ضع_مفتاح_طويل_عشوائي_هنا

# بروكسي سكني ثابت (اختياري لكن مستحسن لفيسبوك)
# ثابت لنفس البروفايل دايمًا — التغيير المستمر بيخطر الشك
WORKER_PROXY=
